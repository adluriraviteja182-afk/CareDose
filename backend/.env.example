SECRET_KEY=change-me
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
VERIFY_THRESHOLD=0.80
HIST_THRESHOLD=0.55
GRACE_MINUTES=30
# Optional email alerts for caregivers
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=caredose@example.com

# ---- production (Render) ----
# APP_ENV=production
# DATABASE_URL=postgresql://user:pass@host/dbname      (the host gives you this)
# DATA_DIR=/data                                       (a persistent disk, so photos and prescriptions survive redeploys)
# CORS_ORIGINS=https://your-site.vercel.app
# PUBLIC_URL=https://your-backend.onrender.com
# VAPID_PRIVATE_KEY=...                                (from: python make_vapid.py)
# VAPID_SUBJECT=mailto:you@example.com
